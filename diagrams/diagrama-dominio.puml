@startuml 01_mapa_de_dominio
title Mapa de Dominio - RutaNorte Logistics
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Aggregate: Cotizacion" {
  class Cotizacion <<Raiz>> {
    Folio
    EstatusDelServicio
    Costo
    fechaRequerida
    --
    emitir()
    confirmar()
    cancelar()
  }
  class VOCotizacion <<ValueObjects>> {
    Folio
    MercanciaDeclarada
    Origen y Destino
    TipoDeUnidad
    RequerimientosEspeciales
    Dinero (Costo)
  }
}

package "Aggregate: OrdenDeServicio" {
  class OrdenDeServicio <<Raiz>> {
    NumeroDeOrden
    FolioDeCotizacion
    EstatusDelServicio
    --
    asignarRecursos()
    reasignarOperador()
    registrarRecoleccion()
    rechazarMercancia()
    registrarEntrega()
    registrarIncidencia()
  }
  class Incidencia <<Entidad>> {
    id local
    TipoDeIncidencia
    TipoDeDiscrepancia
    fotos y observaciones
  }
  class EvidenciaDeEntrega <<ValueObject>> {
    foto
    firma digital
    Receptor
    Coordenadas
    fecha y hora
    inmutable
  }
  class EntradaDeBitacora <<ValueObject>> {
    evento
    estatus
    fecha y hora
    responsable
    no se modifica
  }
  class OtrosVOdeLaOrden <<ValueObjects>> {
    Asignacion
    NumeroDeOrden
    MercanciaDeclarada
    TipoDeDiscrepancia
    TipoDeIncidencia
  }
}

package "Aggregate: Unidad" {
  class Unidad <<Raiz>> {
    Codigo
    TipoDeUnidad
    disponibilidad
    --
    puedeAsignarse()
    marcarAsignada()
    marcarAveriada()
  }
}

package "Aggregate: Operador" {
  class Operador <<Raiz>> {
    Identificador
    disponibilidad
    esComodin
    --
    puedeAsignarse()
    marcarAsignado()
    marcarIndispuesto()
  }
}

package "Solo referencia" {
  class Cliente <<Referencia>> {
    Identificador
    esCorporativo
  }
}

package "Domain Services" {
  class PriorizacionDeAsignacion <<DomainService>> {
    decide que solicitud obtiene la unidad
    criterios: contrato, volumen, antiguedad,
    rentabilidad, orden de llegada
  }
  class PoliticaDeCargaDeAltoValor <<DomainService>> {
    exige unidad escolta y doble firma
    umbral configurable
  }
  class CalculadoraDeCotizacion <<DomainService>> {
    costo por distancia, peso,
    volumen y tipo de unidad
  }
}

package "Eventos de dominio" {
  class EventosDeCotizacion <<DomainEvents>> {
    CotizacionSolicitada
    CotizacionEmitida
    CotizacionConfirmada
    CotizacionCancelada
  }
  class EventosDeLaOrden <<DomainEvents>> {
    OrdenDeServicioGenerada
    UnidadAsignada
    OperadorReasignado
    MercanciaRecolectada
    MercanciaRechazada
    TrasladoIniciado
    AveriaReportada
    DestinatarioAusenteReportado
    EntregaConAnomaliasRegistrada
    EntregaRealizada
  }
}

Cliente "1" --> "0..*" Cotizacion : solicita
Cotizacion "1" --> "0..1" OrdenDeServicio : genera
Cotizacion *-- VOCotizacion
OrdenDeServicio "1" *-- "0..*" Incidencia
OrdenDeServicio "1" *-- "0..1" EvidenciaDeEntrega
OrdenDeServicio "1" *-- "1..*" EntradaDeBitacora
OrdenDeServicio *-- OtrosVOdeLaOrden
OrdenDeServicio ..> Unidad : asigna por id
OrdenDeServicio ..> Operador : asigna por id

PriorizacionDeAsignacion ..> Unidad : consulta
PriorizacionDeAsignacion ..> OrdenDeServicio : coordina
PoliticaDeCargaDeAltoValor ..> OrdenDeServicio : controles
CalculadoraDeCotizacion ..> Cotizacion : calcula costo

Cotizacion ..> EventosDeCotizacion : publica
OrdenDeServicio ..> EventosDeLaOrden : publica
Unidad ..> EventosDeLaOrden : UnidadAsignada
Operador ..> EventosDeLaOrden : OperadorAsignado

note bottom of OrdenDeServicio
  Invariantes:
  1. Solo se crea desde una cotizacion Confirmado (US-04)
  2. Solo Operaciones modifica una orden confirmada (RN-02)
  3. El estatus solo avanza por transiciones validas de G-16
  4. No pasa a Recolectado si la mercancia no coincide (US-05, US-09)
  5. Alto valor exige unidad escolta y doble firma (US-12)
  6. No pasa a Entregado sin evidencia completa e inalterable (RN-03)
  7. Todo cambio de estatus o incidencia agrega bitacora (G-18)
end note

note bottom of Cotizacion
  Estatus: Solicitado, Cotizado, Confirmado
  Pendientes: H-01, H-02, H-05
end note
@enduml
