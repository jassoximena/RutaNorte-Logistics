@startuml 03_secuencia_registrar_entrega
title Secuencia 1 – Registrar entrega con evidencia (CU-04 · US-13 · RN-03)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

participant "Operador" as Op
participant "App del operador" as App
participant "OrdenServicioService" as Svc <<APP>>
participant "UnitOfWork" as UoW <<APP>>
participant "OrdenServicioRepository" as Repo <<DOM>>
participant "Orden de servicio" as Ord <<DOM>>

Op -> App : captura nombre e identificación del destinatario,\nfoto, firma digital, coordenadas y fecha-hora
App -> Svc : confirmarEntrega(numeroDeOrden, destinatario, evidencia)
Svc -> UoW : iniciar()
Svc -> Repo : obtenerPorNumero(numeroDeOrden)
Repo --> Svc : orden
Svc -> Ord : confirmarEntrega(destinatario, evidencia)
Ord -> Ord : valida estatus "Llegada a destino",\nevidencia completa (RN-03) y\ndoble firma si es carga de alto valor

alt evidencia completa y estatus válido
  Ord -> Ord : estatus = "Entregado"\nregistra en Bitácora\nemite EntregaConfirmada
  Ord --> Svc : ok
  Svc -> Repo : guardar(orden)
  Svc -> UoW : confirmar()
  Svc --> App : estatus "Entregado" y evidencia almacenada
  App --> Op : servicio cerrado
else evidencia incompleta o transición inválida
  Ord --> Svc : error de negocio\n(EvidenciaIncompleta / TransicionDeEstatusInvalida)
  Svc -> UoW : revertir()
  Svc --> App : error en términos del negocio
  App --> Op : solicita completar la evidencia
end
@enduml
